static func unit_quad(material: Material) -> QuadMesh:
	var quad:=QuadMesh.new();quad.size=Vector2.ONE;quad.material=material;return quad

func build_emitters() -> void:
	var chip:=StandardMaterial3D.new();chip.vertex_color_use_as_albedo=true;chip.roughness=.9;chip.cull_mode=BaseMaterial3D.CULL_DISABLED
	var spark:=StandardMaterial3D.new();spark.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED;spark.vertex_color_use_as_albedo=true
	spark.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA;spark.blend_mode=BaseMaterial3D.BLEND_MODE_ADD;spark.cull_mode=BaseMaterial3D.CULL_DISABLED
	var glow:=StandardMaterial3D.new();glow.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED;glow.vertex_color_use_as_albedo=true;glow.albedo_texture=dot_texture
	glow.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA;glow.blend_mode=BaseMaterial3D.BLEND_MODE_ADD;glow.billboard_mode=BaseMaterial3D.BILLBOARD_PARTICLES;glow.billboard_keep_scale=true;glow.cull_mode=BaseMaterial3D.CULL_DISABLED
	var glass_chip:=StandardMaterial3D.new();glass_chip.vertex_color_use_as_albedo=true;glass_chip.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA
	glass_chip.roughness=.05;glass_chip.metallic=.3;glass_chip.metallic_specular=1.0
	var shard:=EffectMeshes.chunk(7,Vector3(.016,.012,.014));shard.surface_set_material(0,chip)
