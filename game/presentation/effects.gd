	var dust:=unit_quad(dust_material);var smoke:=unit_quad(smoke_material);var flame:=unit_quad(fire_material);var dot:=unit_quad(glow)
	var grow:=[Vector2(0,.45),Vector2(1,1.55)];var fade_shrink:=[Vector2(0,1),Vector2(1,.25)]
	specs={
		"dust":{"mesh":dust,"amount":5,"life":.9,"speed":[.4,1.3],"spread":40,"gravity":Vector3(0,-.1,0),"damping":2.0,"scale":[.35,.6],"curve":grow,"spin":30,"anim":.2,"colors":[[0,Color(.62,.6,.56,0)],[.12,Color(.6,.58,.54,.55)],[1,Color(.6,.58,.54,0)]]},
		"dust_brown":{"mesh":dust,"amount":6,"life":1.2,"speed":[.6,1.8],"spread":35,"gravity":Vector3(0,-.3,0),"damping":1.6,"scale":[.45,.8],"curve":grow,"spin":30,"anim":.2,"colors":[[0,Color(.34,.27,.2,0)],[.1,Color(.34,.27,.2,.6)],[1,Color(.34,.27,.2,0)]]},
		"smoke_puff":{"mesh":dust,"amount":3,"life":.8,"speed":[.2,.6],"spread":30,"gravity":Vector3(0,.25,0),"damping":1.0,"scale":[.25,.45],"curve":grow,"spin":30,"anim":.2,"colors":[[0,Color(.22,.22,.23,0)],[.15,Color(.22,.22,.23,.45)],[1,Color(.22,.22,.23,0)]]},
		"chips":{"mesh":shard,"amount":7,"life":.7,"speed":[2.0,4.5],"spread":55,"gravity":Vector3(0,-9.8,0),"damping":.2,"scale":[.6,1.3],"colors":[[0,Color(.52,.5,.47)],[1,Color(.46,.45,.42)]],"tumble":720},
		"splinters":{"mesh":splinter,"amount":7,"life":.8,"speed":[1.8,3.8],"spread":55,"gravity":Vector3(0,-9.8,0),"damping":.2,"scale":[.6,1.4],"colors":[[0,Color(.62,.47,.3)],[1,Color(.55,.41,.27)]],"tumble":720},
		"dirt":{"mesh":shard,"amount":10,"life":.9,"speed":[1.5,4.0],"spread":45,"gravity":Vector3(0,-9.8,0),"damping":.3,"scale":[.8,1.6],"colors":[[0,Color(.24,.18,.12)],[1,Color(.2,.15,.1)]],"tumble":600},
