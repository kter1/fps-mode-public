class_name MatchEffects
extends Node3D

# Cosmetic particles use bounded CPU pools to avoid a native GPU particle shader
# leak on repeated macOS match teardown. Everything is allocated once in _ready:
# tracer streaks, per-surface impact particles, bullet-hole decals, muzzle flashes
# (short shadowless lights), brass casings, smoke clouds and explosions.
#
# Fire and smoke are soft billboarded flipbook sprites (content/effects, generated by
# tools/generate_effect_textures.gd) drawn by fx_fire / fx_smoke: depth-faded against
# geometry, smoke lit from a baked sprite normal by the map's sun, its ambient and the
# blast's own light. Sparks are velocity-aligned streaks, debris and brass are small
# simulated pooled bodies that bounce, settle and shrink away.

const SURFACES := ["concrete","metal","earth","wood","flesh"]
const FLASH_LIGHTS := 4
const BURNERS := 4
const BLAST_LIGHTS := 2
const DEBRIS := 44
const SCORCHES := 6
const FX := "res://content/effects/"

# Explosion camera shake: world position and strength (0-1 at the blast).
signal shake_requested(position: Vector3, strength: float)

var effect_budget := 96
var audio := BattleAudio.new()
# Public pool aliases retained for callers that stop transient playback.
var voices: Array[AudioStreamPlayer3D] = []
var player_voices: Array[AudioStreamPlayer] = []
var sounds: Dictionary = {}
var random := RandomNumberGenerator.new()
var time := 0.0
var replay_muted:=false:
	set(value):
		replay_muted=value
		audio.set_replay_muted(value)
var tracers: Array[Dictionary] = []
var tracer_cursor := 0
var casings: Array[Dictionary] = []
var casing_cursor := 0
var emitters: Dictionary = {}
var specs: Dictionary = {}
var emitter_cursor: Dictionary = {}
var decals: Array[Decal] = []
var decal_cursor := 0
var scorches: Array[Decal] = []
var scorch_cursor := 0
var hole_textures: Dictionary = {}
var flashes: Array[Dictionary] = []
var flash_cursor := 0
var casing_mesh: Mesh
var brass: StandardMaterial3D
var brass_first_person: StandardMaterial3D
var smoke_material: ShaderMaterial
var dust_material: ShaderMaterial
var fire_material: ShaderMaterial
var burners: Array[Dictionary] = []
var burn_token := 0
var debris: Array[Dictionary] = []
var debris_cursor := 0
var chunk_meshes: Array[Mesh] = []
var panel_meshes: Array[Mesh] = []
var debris_materials: Dictionary = {}
var blast_flashes: Array[Dictionary] = []
var blast_lights: Array[Dictionary] = []
var blast_cursor := 0
var recent_blasts: Array[float] = []
var last_blast := {"position": Vector3(0, -1000, 0), "started": -10.0, "strength": 1.0}
var lit_light_zero := true
var scorch_texture: Texture2D
var dot_texture: Texture2D
var tracer_mesh: Mesh
var tracer_material: StandardMaterial3D

func _ready() -> void:
	random.seed=872
	for i in BURNERS:burners.append({"root":null,"flame":null,"smoke":null,"light":null,"until":-1.0,"token":0,"size":1.0,"phase":random.randf()*TAU})
	add_child(audio);audio.initialize()
	voices=audio.voices;player_voices=audio.player_voices;sounds=audio.sounds
	if DisplayServer.get_name()=="headless":return
	dot_texture=glow_dot()
	make_materials()
	tracer_mesh=EffectMeshes.tracer(.03)
	tracer_material=StandardMaterial3D.new();tracer_material.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED;tracer_material.vertex_color_use_as_albedo=true
	tracer_material.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA;tracer_material.blend_mode=BaseMaterial3D.BLEND_MODE_ADD;tracer_material.cull_mode=BaseMaterial3D.CULL_DISABLED
	tracer_material.albedo_color=Color(1.7,1.3,.8);tracer_material.disable_receive_shadows=true
	for i in 144:tracers.append(make_tracer())
	casing_mesh=casing_shape()
	# Fired brass: dull, slightly tarnished, no glow.
	brass=StandardMaterial3D.new();brass.albedo_color=Color("a8823f");brass.metallic=.85;brass.roughness=.42
	brass_first_person=brass.duplicate();brass_first_person.use_fov_override=true;brass_first_person.fov_override=ViewModel.FOV
	brass_first_person.use_z_clip_scale=true;brass_first_person.z_clip_scale=ViewModel.DEPTH_SCALE
	for i in 32:
		var casing:=MeshInstance3D.new();casing.mesh=casing_mesh;casing.material_override=brass
		casing.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF;add_child(casing);casing.visible=false
		casings.append({"node":casing,"until":0.0,"velocity":Vector3.ZERO,"spin":Vector3.ZERO,"updated":0.0,"ground":0.0,"bounces":0,"rot":Quaternion.IDENTITY,"settle":Quaternion.IDENTITY,"size":1.0,"flat":false})
	# The first assignment of the first-person brass builds its shader (~90 ms);
	# do it while loading instead of on the player's first shot.
	casings[0].node.material_override=brass_first_person;casings[0].node.material_override=brass
	for surface in ["concrete","metal","earth","wood"]:hole_textures[surface]=hole(surface)
	for i in 64:
		var decal:=Decal.new();decal.size=Vector3(.09,.12,.09);decal.visible=false
		decal.distance_fade_enabled=true;decal.distance_fade_begin=35;decal.distance_fade_length=15
		decal.upper_fade=.2;decal.lower_fade=.2;decal.normal_fade=.25
		add_child(decal);decals.append(decal)
	for i in SCORCHES:
		var scorch:=Decal.new();scorch.visible=false;scorch.texture_albedo=scorch_texture
		scorch.distance_fade_enabled=true;scorch.distance_fade_begin=60;scorch.distance_fade_length=20
		scorch.upper_fade=.3;scorch.lower_fade=.4;scorch.normal_fade=.1
		add_child(scorch);scorches.append(scorch)
	build_emitters()
	build_burners()
	build_debris()
	build_blast()
	configure_light()
	warm_smoke()
	warm_destruction()
	set_process(true)
	for i in FLASH_LIGHTS:flashes.append(make_flash())

func configure_audio(map_id: String) -> void:
	audio.configure(map_id)

func tick(now: float) -> void:
	time=now
	audio.tick(now)
	for tracer in tracers:
		var node:MeshInstance3D=tracer.node
		if not node.visible:continue
		var progress:=(now-float(tracer.started))/maxf(float(tracer.duration),.001)
		if progress>=1:node.visible=false;continue
		var start:Vector3=tracer.start;var end:Vector3=tracer.end
		var length:=minf(float(tracer.length),start.distance_to(end))
		var head:=start.lerp(end,clampf(progress,0,1))
		var tail:=head-(end-start).normalized()*length*clampf(progress*4,0,1)
		node.global_position=(head+tail)*.5;node.scale=Vector3(1,maxf(.01,head.distance_to(tail)),1)
	for casing in casings:
		if casing.node.visible:tick_casing(casing,now)
	for body in debris:
		if body.node.visible:tick_debris(body,now)
	for burner in burners:
		if burner.root!=null and burner.root.visible:
			if now>=float(burner.until):burn_stop_slot(burner)
			else:flicker(burner,now)
	for flash in flashes:
		var light:OmniLight3D=flash.light
		if not light.visible:continue
		var age:=now-float(flash.started)
		if age>.06:light.visible=false;flash.sprite.visible=false;continue
		light.light_energy=float(flash.energy)*(1-age/.06)
	tick_blast(now)

func tick_casing(casing: Dictionary, now: float) -> void:
	var node:MeshInstance3D=casing.node
	var remaining:float=casing.until-now
	if remaining<=0:node.visible=false;return
	var delta:float=clampf(now-casing.updated,0,.05);casing.updated=now
	if remaining<.5:node.scale=Vector3.ONE*float(casing.size)*(remaining/.5)
	if bool(casing.flat):return
	var moving:bool=Vector3(casing.velocity).length_squared()>.0001 or node.position.y>float(casing.ground)+.0001
	if moving:
		casing.velocity.y-=9.8*delta;node.position+=casing.velocity*delta
		var rate:float=Vector3(casing.spin).length()
		if rate>.01:casing.rot=(Quaternion(Vector3(casing.spin)/rate,rate*delta)*casing.rot).normalized()
		node.basis=Basis(casing.rot).scaled(node.scale)
		if node.position.y<casing.ground:
			node.position.y=casing.ground
			if casing.bounces<3 and casing.velocity.y<-.9:
				casing.velocity=Vector3(casing.velocity.x*.5,-casing.velocity.y*.34,casing.velocity.z*.5);casing.spin*=.55;casing.bounces+=1
				casing.rot=casing.rot.slerp(casing.settle,.45)
				if casing.bounces==1:sound("casing",node.position,.12)
			else:
				casing.velocity=Vector3.ZERO;casing.spin=Vector3.ZERO;casing.rot=casing.settle;casing.flat=true
				node.basis=Basis(casing.rot).scaled(node.scale)
				if node.material_override==brass_first_person:node.material_override=brass

func tick_debris(body: Dictionary, now: float) -> void:
	var node:MeshInstance3D=body.node
	var remaining:float=body.until-now
	if remaining<=0:node.visible=false;return
	var delta:float=clampf(now-body.updated,0,.05);body.updated=now
	if remaining<.9:node.scale=Vector3.ONE*float(body.size)*(remaining/.9)
	if bool(body.resting):return
	body.velocity.y-=9.8*delta;node.position+=body.velocity*delta
	var rate:float=Vector3(body.spin).length()
	if rate>.01:body.rot=(Quaternion(Vector3(body.spin)/rate,rate*delta)*body.rot).normalized()
	node.basis=Basis(body.rot).scaled(node.scale)
	var floor_y:float=float(body.ground)+float(body.half)
	if node.position.y<floor_y:
		node.position.y=floor_y
		if body.bounces<3 and body.velocity.y<-2.0:
			body.velocity=Vector3(body.velocity.x*.55,-body.velocity.y*.36,body.velocity.z*.55);body.spin*=.6;body.bounces+=1
		else:body.resting=true;body.spin=Vector3.ZERO

func tick_blast(now: float) -> void:
	var live:=false
	for flash in blast_flashes:
		var sprite:MeshInstance3D=flash.node
		if not sprite.visible:continue
		var age:=now-float(flash.started)
		if age>.18:sprite.visible=false;continue
		var mat:ShaderMaterial=sprite.material_override
		mat.set_shader_parameter("intensity",pow(1.0-age/.18,2.0)*float(flash.strength))
		sprite.scale=Vector3.ONE*float(flash.size)*(.55+age*5.5)
	for light in blast_lights:
		var node:OmniLight3D=light.node
		if not node.visible:continue
		var age:=now-float(light.started)
		if age>.6:node.visible=false;continue
		var envelope:=pow(1.0-age/.6,2.2)
		node.light_energy=float(light.energy)*envelope*(.85+.15*sin(age*90.0))
	# The newest blast lights the smoke around it.
	var blast_age:=now-float(last_blast.started)
	if blast_age<1.0:
		var strength:=pow(1.0-blast_age/1.0,2.0)*float(last_blast.strength)
		lit_light_zero=false;live=true
		for mat in [smoke_material,dust_material]:
			mat.set_shader_parameter("flash_position",last_blast.position);mat.set_shader_parameter("flash_color",Vector3(1.0,.62,.3)*strength*2.2)
	if not live and not lit_light_zero:
		lit_light_zero=true
		for mat in [smoke_material,dust_material]:mat.set_shader_parameter("flash_color",Vector3.ZERO)

func flicker(burner: Dictionary, now: float) -> void:
	var light:OmniLight3D=burner.light
	if not light.visible:return
	var wobble:=.78+.22*sin(now*19.0+float(burner.phase))+.12*sin(now*43.0+float(burner.phase)*2.3)
	light.light_energy=1.5*float(burner.size)*wobble

# --- tracers and impacts -----------------------------------------------------

func tracer(start: Vector3, end: Vector3, impact := true) -> void:
	if tracers.is_empty():return
	var distance := start.distance_to(end)
	if distance<.01:return
	var tracer_row:Dictionary=tracers[tracer_cursor];tracer_cursor=(tracer_cursor+1)%mini(effect_budget,tracers.size())
	var node:MeshInstance3D=tracer_row.node
	tracer_row.start=start;tracer_row.end=end;tracer_row.started=time;tracer_row.length=random.randf_range(1.8,3.2)
	tracer_row.duration=clampf(distance/520.0,.03,.25)
	node.global_basis=Basis(Quaternion(Vector3.UP,(end-start).normalized()));node.global_position=start;node.visible=true
	var camera:=get_viewport().get_camera_3d() if is_inside_tree() else null
	if camera!=null and camera.global_position.distance_to(start)>2.0:world_flash(start,(end-start).normalized())
	if impact:
		impact_at(start,end)

func impact_at(start: Vector3, end: Vector3) -> void:
	var direction:=(end-start).normalized()
	var normal:=-direction;var surface:="flesh";var collider:Object=null
	if is_inside_tree():
		var query:=PhysicsRayQueryParameters3D.create(end-direction*.25,end+direction*.25,1)
		var hit:=get_world_3d().direct_space_state.intersect_ray(query)
		if not hit.is_empty():normal=hit.normal;end=hit.position;collider=hit.collider;surface=surface_of(collider)
	audio.impact(surface,end,direction,normal,time)
	var basis:=Basis(Quaternion(Vector3.UP,normal))
	match surface:
		"metal":emit("sparks",end+normal*.02,basis);emit("spark_glow",end+normal*.03,basis);emit("smoke_puff",end,basis)
		"earth":emit("dirt",end,basis);emit("dust_brown",end,basis)
		"wood":emit("splinters",end,basis);emit("dust",end,basis)
		"flesh":emit("mist",end,basis)
		_:emit("chips",end,basis);emit("dust",end,basis)
	if surface!="flesh":decal_at(end,normal,surface)

# A bullet hole on a surface (also used for panes that shots pass through).
func decal_at(end: Vector3, normal: Vector3, surface: String) -> void:
	if decals.is_empty() or not hole_textures.has(surface):return
	var basis:=Basis(Quaternion(Vector3.UP,normal))
	var decal:=decals[decal_cursor];decal_cursor=(decal_cursor+1)%mini(decals.size(),maxi(16,effect_budget/2))
	decal.texture_albedo=hole_textures[surface].albedo;decal.texture_normal=hole_textures[surface].normal
	var scale:=random.randf_range(.75,1.2)*(1.6 if surface=="earth" else 1.0)
	decal.size=Vector3(.085*scale,.1,.085*scale)
	decal.global_transform=Transform3D(Basis(normal,random.randf_range(0,TAU))*basis,end+normal*.01)
	decal.visible=true

# Surface class for impacts: explicit `surface` metadata on the hit body or its parent
# (maps may set "concrete", "metal", "earth", "wood"), else material and node names.
func surface_of(collider: Object) -> String:
	if collider==null:return "concrete"
	var node:=collider as Node
	for candidate in [node,node.get_parent() if node!=null else null]:
		if candidate!=null and candidate.has_meta("surface"):return str(candidate.get_meta("surface"))
	if node is CharacterBody3D or (node!=null and node.get_parent() is CharacterBody3D):return "flesh"
	var words:=node.name.to_lower() if node!=null else ""
	var parent:=node.get_parent() if node!=null else null
	if parent!=null:
		words+=" "+str(parent.name).to_lower()
		for child in parent.get_children():
			if child is MeshInstance3D:
				var material:=child.get_active_material(0) as BaseMaterial3D
				if material!=null and material.albedo_texture!=null:words+=" "+material.albedo_texture.resource_path.to_lower()
				if material!=null and material.metallic>.4:words+=" metal"
	for key in ["steel","metal","iron","rust","container","freight","rail","pipe","vent","gantry","corrugated"]:
		if key in words:return "metal"
	for key in ["wood","plank","pallet","crate"]:
		if key in words:return "wood"
	for key in ["earth","dirt","grass","gravel","mud","sand","terrain","forest","soil","rock"]:
		if key in words:return "earth"
	return "concrete"

# Fires a pooled emitter. `scale` sizes the sprites and (as its square root) the speeds.
func emit(kind: String, position: Vector3, basis: Basis, scale := 1.0) -> void:
	if not emitters.has(kind):return
	var pool:Array=emitters[kind]
	var cursor:int=emitter_cursor.get(kind,0);emitter_cursor[kind]=(cursor+1)%pool.size()
	var particles:CPUParticles3D=pool[cursor]
	particles.visible=true
	var spec:Dictionary=specs[kind];var reach:=sqrt(scale)
	particles.scale_amount_min=spec.scale[0]*scale;particles.scale_amount_max=spec.scale[1]*scale
	particles.initial_velocity_min=spec.speed[0]*reach;particles.initial_velocity_max=spec.speed[1]*reach
	particles.global_transform=Transform3D(basis,position);particles.restart()

# --- muzzle flashes and casings ---------------------------------------------

func world_flash(position: Vector3, direction: Vector3) -> void:
	if flashes.is_empty():return
	var flash:Dictionary=flashes[flash_cursor];flash_cursor=(flash_cursor+1)%flashes.size()
	var sprite:MeshInstance3D=flash.sprite
	sprite.global_position=position+direction*.08;sprite.visible=true
	var mat:=sprite.material_override as StandardMaterial3D
	var frame:=random.randi_range(0,3);mat.uv1_offset=Vector3((frame%2)*.5,(frame/2)*.5,0)
	sprite.scale=Vector3.ONE*random.randf_range(.8,1.3)
	var light:OmniLight3D=flash.light;light.global_position=position;light.visible=true;light.omni_range=5
	flash.started=time;flash.energy=random.randf_range(2.4,3.4);light.light_energy=flash.energy

# Spent brass leaves the ejection port to the right, up and a little back, tumbling,
# bounces on the floor, lies down on its side, then shrinks away. `direction` is the
# gun's right-hand vector.
func eject_casing(position:Vector3,direction:Vector3) -> void:
	if casings.is_empty():return
	var camera:=get_viewport().get_camera_3d() if is_inside_tree() else null
	var start:=position;var side:=direction.normalized();var first_person:=false
	var forward:=Vector3.UP.cross(side).normalized()
	# The player's own brass leaves the first-person weapon's ejection port.
	if camera!=null and camera.global_position.distance_to(position)<1.2 and ViewModel.active!=null and ViewModel.active.visible:
		var port:=ViewModel.active.ejection_transform()
		if port!=Transform3D.IDENTITY:start=port.origin;side=port.basis.x.normalized();forward=-port.basis.z.normalized();first_person=true
	# Other soldiers' brass is not worth simulating out of sight; it leaves the receiver,
	# a forearm behind the muzzle.
	elif camera!=null and camera.global_position.distance_to(position)>38:return
	else:start=position-forward*.4+side*.04-Vector3.UP*.04
	var casing:Dictionary=casings[casing_cursor];casing_cursor=(casing_cursor+1)%casings.size()
	var node:MeshInstance3D=casing.node
	if first_person:brass_first_person.fov_override=ViewModel.active.fov
	node.material_override=brass_first_person if first_person else brass
	var size:=.8 if first_person else 1.0
	if first_person and ViewModel.active.player!=null and ViewModel.active.player.weapon().definition.category=="sidearm":size=.5
	casing.size=size;node.scale=Vector3.ONE*size
	var axis:=(forward*.7+side*random.randf_range(-.4,.6)+Vector3.UP*random.randf_range(-.2,.5)).normalized()
	casing.rot=Quaternion(Vector3.UP,axis)
	var lie:=random.randf()*TAU
	casing.settle=Quaternion(Vector3.UP,Vector3(cos(lie),0,sin(lie)))
	node.position=start;node.basis=Basis(casing.rot).scaled(node.scale)
	node.visible=true;casing.until=time+4.2;casing.updated=time;casing.bounces=0;casing.flat=false
	casing.ground=floor_below(start)
	# Up, right and back out of the port: a short visible arc past the shooter's cheek.
	casing.velocity=side*random.randf_range(.9,1.4)+Vector3.UP*random.randf_range(1.5,2.1)-forward*random.randf_range(.5,.9)+Vector3(random.randf_range(-.12,.12),0,random.randf_range(-.12,.12))
	var tumble:=side.cross(Vector3.UP).normalized()
	casing.spin=tumble*random.randf_range(14,34)*(1.0 if random.randf()<.5 else -1.0)+axis*random.randf_range(-40,40)

func floor_below(position: Vector3) -> float:
	if not is_inside_tree():return position.y-1.3
	var query:=PhysicsRayQueryParameters3D.create(position,position+Vector3.DOWN*3,1)
	var hit:=get_world_3d().direct_space_state.intersect_ray(query)
	return float(hit.position.y)+.006 if not hit.is_empty() else position.y-1.3

# --- smoke and explosions ----------------------------------------------------

# Visual smoke volume; gameplay occlusion stays in MatchWorld.visible_between.
# The cloud is simulated ahead (preprocess) so it occludes from its first frame, and
# its particles fade out by the time MatchWorld retires the cloud (10 s after the throw).
func smoke_cloud(center:Vector3) -> Node3D:
	var cloud:=Node3D.new();cloud.name="SmokeCloud";add_child(cloud);cloud.global_position=center
	if DisplayServer.get_name()=="headless":return cloud
	var particles:=CPUParticles3D.new();particles.name="Smoke";particles.emitting=false
	particles.amount=64;particles.lifetime=12.5;particles.preprocess=2.5;particles.explosiveness=.9;particles.one_shot=true
	particles.lifetime_randomness=.15
	particles.use_fixed_seed=true;particles.seed=872
	# 15 Hz (interpolated) is indistinguishable for slow smoke and keeps the
	# pre-simulation inside the detonation tick cheap.
	particles.fixed_fps=15;particles.local_coords=false
	particles.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	particles.draw_order=CPUParticles3D.DRAW_ORDER_VIEW_DEPTH
	particles.visibility_aabb=AABB(Vector3(-16,-8,-16),Vector3(32,24,32))
	particles.emission_shape=CPUParticles3D.EMISSION_SHAPE_SPHERE;particles.emission_sphere_radius=2.6
	particles.direction=Vector3.UP;particles.spread=180;particles.initial_velocity_min=.4;particles.initial_velocity_max=1.8
	particles.damping_min=1.4;particles.damping_max=2.2;particles.gravity=Vector3(.1,.14,.04)
	particles.angle_min=-180;particles.angle_max=180;particles.angular_velocity_min=-5;particles.angular_velocity_max=5
	particles.anim_speed_min=.05;particles.anim_speed_max=.2;particles.anim_offset_min=0;particles.anim_offset_max=1
	particles.scale_amount_min=3.6;particles.scale_amount_max=6.2
	particles.scale_amount_curve=curve([Vector2(0,.55),Vector2(.15,.9),Vector2(1,1.15)]).curve
	particles.color_ramp=gradient([[0,Color(.82,.84,.86,0)],[.04,Color(.8,.82,.84,.78)],[.82,Color(.76,.78,.8,.7)],[1,Color(.76,.78,.8,0)]]).gradient
	particles.mesh=unit_quad(smoke_material)
	cloud.add_child(particles);particles.emitting=true;particles.restart()
	return cloud

# One throwaway cloud far below the map at load time, so the first grenade in a
# match does not pay the one-off particle and material setup.
func warm_smoke() -> void:
	var cloud:=smoke_cloud(Vector3(0,-500,0))
	get_tree().create_timer(.5,true,false,true).timeout.connect(cloud.queue_free)

# Pipelines compile on first draw, and an effect that is never in view never draws. For the
# first frames a camera exists, every effect fires once, microscopic, right in front of it,
# so the first real blast, spark or smoke in a match does not stall on shader compilation.
var warm_frames := 0
var warm_spot := Vector3(0,-1000,0)
func _process(_delta: float) -> void:
	if DisplayServer.get_name()=="headless" or warm_frames>=4:return
	var camera:=get_viewport().get_camera_3d() if is_inside_tree() else null
	if camera==null:return
	warm_frames+=1
	if warm_frames==4:
		# The match clock (which ages these) does not run until the countdown ends, so the
		# warm-up pieces are put away here: nothing is left floating in front of the player.
		for scorch in scorches:scorch.visible=false
		for decal in decals:decal.visible=false
		for body in debris:body.node.visible=false;body.until=-1.0
		for flash in blast_flashes:flash.node.visible=false
		for light in blast_lights:light.node.visible=false
		last_blast.started=-10.0
		for kind in emitters:
			for particles:CPUParticles3D in emitters[kind]:
				if particles.global_position.distance_to(warm_spot)<.01:particles.emitting=false;particles.visible=false
		return
	if warm_frames!=2:return
	var spot:=camera.global_position-camera.global_basis.z*1.2
	warm_spot=spot
	# The first visible decal switches every surface in view to its decal shader variant.
	for decal in [scorches[0],decals[0]]:
		decal.size=Vector3(.05,.1,.05);decal.global_transform=Transform3D(Basis.IDENTITY,spot);decal.visible=true
	for kind in emitters:emit(kind,spot,Basis.IDENTITY,.01)
	blast_glow(spot,.01)
	spawn_debris(spot,spot.y-1.0,.05,2,1)
	# Panels ignore the blast scale (they are full car doors): shrink the warm-up ones to
	# specks and hide them with the rest, so no slab is left lying in front of the player.
	for i in 3:
		var body:Dictionary=debris[(debris_cursor-1-i+debris.size())%debris.size()]
		body.size=.02;body.half=.001;body.until=time+.1
		var node:MeshInstance3D=body.node;node.scale=Vector3.ONE*.02;node.basis=Basis(body.rot).scaled(node.scale)
	get_tree().create_timer(.3,true,false,true).timeout.connect(func() -> void:
		for i in 3:debris[(debris_cursor-1-i+debris.size())%debris.size()].node.visible=false)
	var handle:=burning(spot,time+.3,.05,true,true)
	get_tree().create_timer(.3,true,false,true).timeout.connect(burn_stop.bind(handle))

# One throwaway flame, blast and shard burst far below the map at load, so the first
# barrel or car in a match does not pay one-off particle setup.
func warm_destruction() -> void:
	var far:=Vector3(0,-500,0)
	var handle:=burning(far,time+.5,1.0)
	for kind in ["fireball","fire_rise","blast_smoke","blast_sparks","dust_ring","embers","glass","spark_glow","sparks"]:emit(kind,far,Basis.IDENTITY)
	get_tree().create_timer(.6,true,false,true).timeout.connect(burn_stop.bind(handle))

# `scale` sizes the sound, fireball and smoke; `shake` is the camera-shake strength at
# the blast; `panels` throws that many sheet-metal pieces (car doors and bonnet).
func explosion(center:Vector3,scale:=1.0,shake:=1.0,panels:=0) -> void:
	sound("explosion" if sounds.has("explosion") else "shotgun",center,2.0*scale)
	shake_requested.emit(center,shake)
	if emitters.is_empty():return
	recent_blasts=recent_blasts.filter(func(at:float):return time-at<3.0);recent_blasts.append(time)
	var crowded:=recent_blasts.size()>3
	var ground:=floor_below(center+Vector3.UP*.3)
	var up:=Basis.IDENTITY
	emit("fireball",center+Vector3.UP*.5*scale,up,scale)
	emit("fire_rise",center+Vector3.UP*.1,up,scale)
	emit("blast_smoke",center+Vector3.UP*.3,up,scale)
	emit("blast_sparks",center,up,scale)
	emit("dust_ring",Vector3(center.x,ground+.6,center.z),up,scale)
	if not crowded:
		emit("smoke_lingering",center+Vector3.UP*.6,up,scale);emit("embers",center,up,scale)
	spawn_debris(center,ground,scale,8 if crowded else 16,panels)
	blast_glow(center+Vector3.UP*.45*scale,scale)
	if not scorches.is_empty():
		var scorch:=scorches[scorch_cursor];scorch_cursor=(scorch_cursor+1)%scorches.size()
		scorch.size=Vector3(4.6*scale,1.0,4.6*scale)
		scorch.global_transform=Transform3D(Basis(Vector3.UP,random.randf_range(0,TAU)),Vector3(center.x,ground+.05,center.z));scorch.visible=true

# A hot white flash sprite and a warm light that dies off over half a second.
func blast_glow(position:Vector3,scale:float) -> void:
	var slot:=blast_cursor;blast_cursor=(blast_cursor+1)%BLAST_LIGHTS
	var flash:Dictionary=blast_flashes[slot];var sprite:MeshInstance3D=flash.node
	sprite.global_position=position;sprite.visible=true;flash.started=time;flash.size=5.5*scale;flash.strength=1.0
	# The size tick_blast gives it at age zero: before the match clock runs (the warm-up) it is not ticked.
	sprite.scale=Vector3.ONE*float(flash.size)*.55
	var light:Dictionary=blast_lights[slot];var node:OmniLight3D=light.node
	node.global_position=position+Vector3.UP*.3;node.omni_range=11.0*scale;light.energy=11.0*scale;light.started=time;node.light_energy=light.energy;node.visible=true
	last_blast={"position":position,"started":time,"strength":scale}

# Burning metal and rock: simulated bodies that fall, bounce, rest and shrink away.
func spawn_debris(center:Vector3,ground:float,scale:float,count:int,panels:=0) -> void:
	if debris.is_empty():return
	var reach:=sqrt(scale)
	for i in count+panels:
		var body:Dictionary=debris[debris_cursor];debris_cursor=(debris_cursor+1)%debris.size()
		var node:MeshInstance3D=body.node
		var panel:=i>=count
		var pool:Array=panel_meshes if panel else chunk_meshes
		node.mesh=pool[random.randi()%pool.size()]
		node.material_override=debris_materials.panel if panel else debris_materials.chunks[random.randi()%debris_materials.chunks.size()]
		var heading:=Vector3(random.randf_range(-1,1),0,random.randf_range(-1,1)).normalized()
		var lift:=random.randf_range(.55,1.5) if not panel else random.randf_range(.8,1.5)
		var speed:=random.randf_range(4.0,12.0)*reach if not panel else random.randf_range(5.0,9.0)*reach
		body.velocity=(heading+Vector3.UP*lift).normalized()*speed
		var axis:=Vector3(random.randf_range(-1,1),random.randf_range(-1,1),random.randf_range(-1,1)).normalized()
		body.spin=axis*random.randf_range(4,20)*(1.5 if panel else 1.0)
		body.size=random.randf_range(.7,1.5)*(1.0 if panel else minf(reach,1.3));body.half=.04*float(body.size)
		body.rot=Quaternion(axis,random.randf()*TAU);node.scale=Vector3.ONE*float(body.size)
		node.position=center+Vector3(heading.x*.4,random.randf_range(.0,.5),heading.z*.4);node.basis=Basis(body.rot).scaled(node.scale);node.visible=true
		body.until=time+random.randf_range(4.5,7.0);body.updated=time;body.ground=ground;body.resting=false;body.bounces=0

# Sheet-metal pieces thrown from a destroyed vehicle (used on their own as well).
func throw_panels(center:Vector3,count:int) -> void:
	spawn_debris(center,floor_below(center),1.4,0,count)

func glass_burst(point:Vector3,normal:Vector3) -> void:
	sound("glass",point,1.0)
	if emitters.is_empty():return
	emit("glass",point,Basis(Quaternion(Vector3.UP,normal)));emit("glass",point,Basis(Quaternion(Vector3.UP,-normal)))

# Pooled flame/smoke emitters (at most BURNERS alive; the one expiring soonest is
# reused). Returns a handle for burn_stop. `flames` false gives smoke only; `dark`
# makes the smoke black (burning oil and rubber, a car engine).
func burning(position:Vector3,until:float,size:float,flames:=true,dark:=false) -> Dictionary:
	var slot:=0;var free:=-1
	for i in burners.size():
		if float(burners[i].until)<=time and free<0:free=i
		if float(burners[i].until)<float(burners[slot].until):slot=i
	if free>=0:slot=free
	var burner:Dictionary=burners[slot];burn_token+=1
	burner.until=until;burner.token=burn_token;burner.size=size
	if burner.root!=null:
		var root:Node3D=burner.root;root.global_position=position;root.visible=true
		var flame:CPUParticles3D=burner.flame;var smoke:CPUParticles3D=burner.smoke;var light:OmniLight3D=burner.light
		smoke.color_ramp=burner_smoke_dark if dark else burner_smoke_light
		size_burner(burner,size)
		light.visible=flames;light.global_position=position+Vector3.UP*(.35+.25*size)
		flame.restart();smoke.restart();flame.emitting=flames
	return {"slot":slot,"token":burn_token}

func size_burner(burner:Dictionary,size:float) -> void:
	var flame:CPUParticles3D=burner.flame;var smoke:CPUParticles3D=burner.smoke
	burner.size=size
	flame.scale_amount_min=.7*size+.25;flame.scale_amount_max=1.3*size+.4
	flame.initial_velocity_min=.5+size*.7;flame.initial_velocity_max=1.2+size*1.1;flame.emission_sphere_radius=.1+.28*size
	smoke.scale_amount_min=.9*size+.4;smoke.scale_amount_max=1.8*size+.6;smoke.emission_sphere_radius=.12+.25*size
	smoke.initial_velocity_min=.8+size*.4;smoke.initial_velocity_max=1.6+size*.8
	var light:OmniLight3D=burner.light;light.omni_range=3.0+3.0*size

# Grows a live burner (a car about to blow) without restarting its particles.
func burn_resize(handle:Dictionary,size:float) -> void:
	if handle.is_empty() or burners[handle.slot].token!=handle.token or burners[handle.slot].root==null:return
	size_burner(burners[handle.slot],size)

func burn_stop(handle:Dictionary) -> void:
	if handle.is_empty():return
	var burner:Dictionary=burners[handle.slot]
	if burner.token==handle.token:burn_stop_slot(burner)

func burn_stop_slot(burner:Dictionary) -> void:
	burner.until=-1.0
	if burner.root!=null:
		burner.flame.emitting=false;burner.smoke.emitting=false;burner.root.visible=false;burner.light.visible=false

func live_burners() -> int:
	var count:=0
	for burner in burners:
		if float(burner.until)>time:count+=1
	return count

var burner_smoke_dark: Gradient
var burner_smoke_light: Gradient

func build_burners() -> void:
	var flame_ramp:=gradient([[0,Color(1,1,1,0)],[.1,Color(1,1,1,.95)],[.5,Color(1,.9,.8,.8)],[.88,Color(.8,.6,.5,0)],[1,Color(.7,.5,.4,0)]]).gradient
	burner_smoke_light=gradient([[0,Color(.4,.38,.36,0)],[.12,Color(.34,.33,.32,.55)],[1,Color(.4,.4,.4,0)]]).gradient
	burner_smoke_dark=gradient([[0,Color(.1,.1,.1,0)],[.1,Color(.07,.07,.07,.8)],[1,Color(.22,.22,.22,0)]]).gradient
	var flame_quad:=unit_quad(fire_material);var smoke_quad:=unit_quad(smoke_material)
	var grow:=curve([Vector2(0,.45),Vector2(1,1.5)]).curve
	var rise:=curve([Vector2(0,.7),Vector2(.4,1.0),Vector2(1,.35)]).curve
	for burner in burners:
		var root:=Node3D.new();root.visible=false;add_child(root)
		for part in ["flame","smoke"]:
			var particles:=CPUParticles3D.new();particles.emitting=false;particles.local_coords=false
			particles.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF;particles.use_fixed_seed=true;particles.seed=872
			particles.emission_shape=CPUParticles3D.EMISSION_SHAPE_SPHERE;particles.direction=Vector3.UP
			particles.angle_min=-180;particles.angle_max=180;particles.draw_order=CPUParticles3D.DRAW_ORDER_VIEW_DEPTH
			particles.visibility_aabb=AABB(Vector3(-6,-2,-6),Vector3(12,14,12))
			if part=="flame":
				particles.amount=12;particles.lifetime=.85;particles.lifetime_randomness=.3;particles.spread=16;particles.gravity=Vector3(0,2.2,0)
				particles.anim_speed_min=.55;particles.anim_speed_max=.85;particles.anim_offset_min=0;particles.anim_offset_max=.25
				particles.mesh=flame_quad;particles.color_ramp=flame_ramp;particles.scale_amount_curve=rise
				particles.angular_velocity_min=-40;particles.angular_velocity_max=40
			else:
				particles.amount=30;particles.lifetime=3.8;particles.lifetime_randomness=.25;particles.spread=20;particles.gravity=Vector3(.2,.8,.06);particles.damping_min=.6;particles.damping_max=1.0
				particles.anim_speed_min=.1;particles.anim_speed_max=.3;particles.anim_offset_min=0;particles.anim_offset_max=1
				particles.mesh=smoke_quad;particles.color_ramp=burner_smoke_light;particles.scale_amount_curve=grow
				particles.angular_velocity_min=-12;particles.angular_velocity_max=12
			root.add_child(particles);burner[part]=particles
		var light:=OmniLight3D.new();light.light_color=Color(1,.55,.22);light.omni_range=4;light.light_energy=1.5;light.shadow_enabled=false;light.visible=false
		add_child(light);burner.light=light
		burner.root=root

func build_debris() -> void:
	for i in 6:chunk_meshes.append(EffectMeshes.chunk(100+i,Vector3(random.randf_range(.1,.22),random.randf_range(.06,.13),random.randf_range(.09,.2))))
	for i in 3:panel_meshes.append(EffectMeshes.panel(Vector3(random.randf_range(.8,1.2),.018,random.randf_range(.5,.8))))
	var charred:=StandardMaterial3D.new();charred.albedo_color=Color(.045,.04,.037);charred.roughness=.9
	var rusty:=StandardMaterial3D.new();rusty.albedo_color=Color(.2,.1,.05);rusty.roughness=.75;rusty.metallic=.4
	var stone:=StandardMaterial3D.new();stone.albedo_color=Color(.22,.2,.18);stone.roughness=.95
	var panel:=StandardMaterial3D.new();panel.albedo_color=Color(.07,.065,.06);panel.metallic=.55;panel.roughness=.6;panel.cull_mode=BaseMaterial3D.CULL_DISABLED
	debris_materials={"chunks":[charred,rusty,stone],"panel":panel}
	for i in DEBRIS:
		var node:=MeshInstance3D.new();node.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF;node.visible=false;add_child(node)
		debris.append({"node":node,"velocity":Vector3.ZERO,"spin":Vector3.ZERO,"rot":Quaternion.IDENTITY,"until":0.0,"updated":0.0,"ground":0.0,"half":.04,"size":1.0,"resting":false,"bounces":0})

func build_blast() -> void:
	var shader:=load(FX+"fx_flash.gdshader") as Shader
	for i in BLAST_LIGHTS:
		var sprite:=MeshInstance3D.new();sprite.mesh=unit_quad(null);sprite.visible=false;sprite.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		var mat:=ShaderMaterial.new();mat.shader=shader;sprite.material_override=mat;add_child(sprite)
		blast_flashes.append({"node":sprite,"started":-10.0,"size":4.0,"strength":1.0})
		var light:=OmniLight3D.new();light.light_color=Color(1,.62,.3);light.shadow_enabled=false;light.visible=false;light.omni_range=10;add_child(light)
		blast_lights.append({"node":light,"started":-10.0,"energy":10.0})

# Reads the map's sun and ambient light so smoke is shaded like the scene around it.
func configure_light() -> void:
	var parent:=get_parent()
	var arena:Node=parent.get("arena") if parent!=null else null
	var sun:DirectionalLight3D=null;var energy:=.5
	if arena!=null:
		sun=arena.get_node_or_null("Sun") as DirectionalLight3D
		for child in arena.get_children():
			if child is WorldEnvironment and child.environment!=null and child.environment.sky!=null:
				var sky_material:=child.environment.sky.sky_material as PanoramaSkyMaterial
				if sky_material!=null:energy=sky_material.energy_multiplier
	var direction:=Vector3(.3,-.75,.4).normalized();var color:=Vector3(1,.95,.88)
	if sun!=null:
		direction=-sun.global_basis.z.normalized();color=Vector3(sun.light_color.r,sun.light_color.g,sun.light_color.b)*minf(sun.light_energy,2.0)*.34
	var ambient:=Vector3(.58,.65,.78)*clampf(energy,.3,1.2)*.42
	for mat in [smoke_material,dust_material]:
		mat.set_shader_parameter("sun_direction",direction);mat.set_shader_parameter("sun_color",color);mat.set_shader_parameter("ambient_color",ambient)

func set_quality(quality:int) -> void:
	effect_budget=[48,96,144][clampi(quality,0,2)]
	tracer_cursor=0
	for i in range(effect_budget,tracers.size()):tracers[i].node.visible=false
	var keep:int=[24,40,64][clampi(quality,0,2)]
	for i in range(keep,decals.size()):decals[i].visible=false

func sound(kind: String, position: Vector3, volume := 1.0, priority := false) -> void:
	audio.play_sound(kind,position,volume,priority)

