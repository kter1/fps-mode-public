# A CPUParticles3D set up from a spec dictionary (see build_emitters).
func make_particles(spec:Dictionary,seed_value:int) -> CPUParticles3D:
	var particles:=CPUParticles3D.new();particles.amount=int(spec.amount);particles.lifetime=float(spec.life)
	particles.lifetime_randomness=float(spec.get("life_random",0))
	particles.use_fixed_seed=true;particles.seed=seed_value
	particles.explosiveness=float(spec.get("explosive",1.0));particles.local_coords=false
	particles.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF;particles.mesh=spec.mesh
	var reach:=float(spec.get("aabb",6))
	particles.visibility_aabb=AABB(Vector3(-reach,-reach*.5,-reach),Vector3(reach*2,reach*1.5,reach*2))
	particles.direction=Vector3.UP;particles.spread=float(spec.spread)
	particles.initial_velocity_min=spec.speed[0];particles.initial_velocity_max=spec.speed[1];particles.gravity=spec.gravity
	particles.damping_min=float(spec.damping);particles.damping_max=float(spec.damping)*1.4
	particles.scale_amount_min=spec.scale[0];particles.scale_amount_max=spec.scale[1]
	particles.color_ramp=gradient(spec.colors).gradient
	if spec.has("curve"):particles.scale_amount_curve=curve(spec.curve).curve
	if spec.has("spin"):
		particles.angle_min=-180;particles.angle_max=180;particles.angular_velocity_min=-float(spec.spin);particles.angular_velocity_max=float(spec.spin)
	if spec.has("anim"):
		particles.anim_speed_min=float(spec.anim)*.8;particles.anim_speed_max=float(spec.anim)*1.2
		particles.anim_offset_min=float(spec.get("anim_offset",0.0))*0.0;particles.anim_offset_max=float(spec.get("anim_offset",0.0))
	if spec.has("tumble"):particles.angular_velocity_min=-float(spec.tumble);particles.angular_velocity_max=float(spec.tumble);particles.particle_flag_rotate_y=true
	if spec.get("align",false):particles.particle_flag_align_y=true
	if spec.has("radius"):particles.emission_shape=CPUParticles3D.EMISSION_SHAPE_SPHERE;particles.emission_sphere_radius=float(spec.radius)
	if spec.get("ring",false):
		particles.emission_shape=CPUParticles3D.EMISSION_SHAPE_RING;particles.emission_ring_axis=Vector3.UP;particles.emission_ring_height=.1
		particles.emission_ring_radius=.7;particles.emission_ring_inner_radius=.5;particles.direction=Vector3.RIGHT
		particles.radial_accel_min=spec.radial[0];particles.radial_accel_max=spec.radial[1]
	if spec.get("anim",0.0)!=0.0 or spec.mesh is QuadMesh:particles.draw_order=CPUParticles3D.DRAW_ORDER_VIEW_DEPTH
	return particles

static func gradient(points:Array) -> GradientTexture1D:
	var ramp:=Gradient.new();ramp.offsets=PackedFloat32Array();ramp.colors=PackedColorArray()
	for point in points:ramp.add_point(float(point[0]),point[1])
	var texture:=GradientTexture1D.new();texture.gradient=ramp;return texture

static func curve(points:Array) -> CurveTexture:
	var shape:=Curve.new();shape.max_value=3
	for point in points:shape.add_point(point)
	var texture:=CurveTexture.new();texture.curve=shape;return texture

# Soft round glow for embers and spark flashes.
func glow_dot() -> Texture2D:
	var texture:=GradientTexture2D.new();texture.fill=GradientTexture2D.FILL_RADIAL;texture.fill_from=Vector2(.5,.5);texture.fill_to=Vector2(.5,0)
	texture.width=64;texture.height=64
	texture.gradient=gradient([[0,Color(1,1,1,1)],[.35,Color(1,1,1,.45)],[1,Color(1,1,1,0)]]).gradient
	return texture

# Bullet holes per surface: albedo with alpha and a crater normal map.
func hole(surface: String) -> Dictionary:
	var size:=64;var albedo:=Image.create(size,size,false,Image.FORMAT_RGBA8);var height:=PackedFloat32Array();height.resize(size*size)
	var noise:=FastNoiseLite.new();noise.seed=hash(surface);noise.frequency=.18
	var spec:Array={"concrete":[.1,.42,Color(.12,.11,.1),Color(.62,.6,.56)],"metal":[.07,.2,Color(.04,.04,.04),Color(.72,.72,.7)],
		"earth":[.2,.48,Color(.09,.07,.05),Color(.2,.15,.1)],"wood":[.07,.3,Color(.1,.07,.05),Color(.72,.58,.4)],"flesh":[.0,.0,Color.BLACK,Color.BLACK]}[surface]
	for y in size:
		for x in size:
			var d:=Vector2(x+.5-size*.5,y+.5-size*.5)/(size*.5)
			var r:=d.length()*(1+noise.get_noise_2d(x*2.0,y*2.0)*.35)
			var core:=1.0-smoothstep(spec[0]*.8,spec[0]*1.25,r)
			var ring:=1.0-smoothstep(spec[1]*.6,spec[1],r)
			var colour:Color=Color(spec[3]).lerp(spec[2],core)
			var alpha:=maxf(core,ring*(.85 if surface!="earth" else .6))
			albedo.set_pixel(x,y,Color(colour,alpha))
			height[y*size+x]=-core*1.0-ring*.25
	var normal:=Image.create(size,size,false,Image.FORMAT_RGBA8)
	for y in size:
		for x in size:
			var dx:=height[y*size+mini(x+1,size-1)]-height[y*size+maxi(x-1,0)]
			var dy:=height[mini(y+1,size-1)*size+x]-height[maxi(y-1,0)*size+x]
			var n:=Vector3(-dx*2.5,-dy*2.5,1).normalized()
			normal.set_pixel(x,y,Color(n.x*.5+.5,n.y*.5+.5,n.z*.5+.5))
	return {"albedo":ImageTexture.create_from_image(albedo),"normal":ImageTexture.create_from_image(normal)}

# Rifle case (lathe): rim, extractor groove, body taper, shoulder and neck.
func casing_shape() -> Mesh:
	var profile:=[Vector2(0,0),Vector2(0,.0047),Vector2(.0013,.0047),Vector2(.0016,.0040),Vector2(.0028,.0040),Vector2(.0034,.0048),Vector2(.034,.0045),Vector2(.037,.0032),Vector2(.045,.0031),Vector2(.045,0)]
	var tool:=SurfaceTool.new();tool.begin(Mesh.PRIMITIVE_TRIANGLES)
	var segments:=10
	for i in profile.size()-1:
		for s in segments:
			var a0:=TAU*s/segments;var a1:=TAU*(s+1)/segments
			var p:=[profile[i],profile[i+1]]
			var quad:=[Vector3(cos(a0)*p[0].y,p[0].x,sin(a0)*p[0].y),Vector3(cos(a1)*p[0].y,p[0].x,sin(a1)*p[0].y),
				Vector3(cos(a1)*p[1].y,p[1].x,sin(a1)*p[1].y),Vector3(cos(a0)*p[1].y,p[1].x,sin(a0)*p[1].y)]
			for index in [0,2,1,0,3,2]:tool.add_vertex(quad[index]-Vector3(0,.0225,0))
	tool.generate_normals();return tool.commit()
