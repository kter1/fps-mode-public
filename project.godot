; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FPS Mode"
config/version="0.4.0"
run/main_scene="res://game/core/app.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/map_baker/plugin.cfg")

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Characters"
3d_physics/layer_3="Hurtboxes"
3d_physics/layer_4="Supplies"
3d_physics/layer_5="Grenades"
3d_physics/layer_6="Triggers"

[physics]

3d/default_gravity=24.0
common/physics_interpolation=true

[rendering]

renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.065, 1)
